---
// Rota dinâmica: gera uma página para cada post encontrado em
// content/posts/. O slug vem do nome da pasta/arquivo; não
// precisamos criar manualmente uma página por post.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { longDate } from '../../lib/format';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };

// `render()` processa o Markdown do post, incluindo syntax
// highlighting de código (Shiki) e acessível ao SEO.
const { Content } = await render(post);

const { title, description, pubDate, tags, updatedDate } = post.data;

// Mostra o marcador "Editado em" apenas quando houve alguma edição
// real e em dia diferente do da publicação original.
const hasEdit =
  updatedDate &&
  (updatedDate.getUTCFullYear() !== pubDate.getUTCFullYear() ||
    updatedDate.getUTCMonth() !== pubDate.getUTCMonth() ||
    updatedDate.getUTCDate() !== pubDate.getUTCDate());
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/posts/${post.id}`}
  type="article"
>
  <article>
    <header class="container post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        Publicado em {longDate.format(pubDate)}
        {hasEdit && (
          <span class="post-edited">
            · Editado em {longDate.format(updatedDate!)}
          </span>
        )}
      </p>
    </header>

    <div class="container post-body">
      <div class="prose">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags deste post">
            {tags.map((tag) => (
              <li>
                <a href={withBase(`/tags/${tag}`)}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</BaseLayout>