---
import { getCollection } from 'astro:content';
import { execFileSync } from 'node:child_process';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { withBase } from '../lib/paths';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const recentPosts = posts.slice(0, 10);

// Últimas alterações relevantes dos projetos, obtidas do histórico Git.
// Alterações pequenas são ignoradas; cada capítulo/documento ocupa só uma posição.
const projects = await getCollection('projects', ({ data }) => data.published);
const [chapters, supplements, documents] = await Promise.all([
  getCollection('projectChapters', ({ data }) => data.published),
  getCollection('projectSupplements', ({ data }) => data.published),
  getCollection('projectDocs', ({ data }) => data.published),
]);
const projectById = new Map(projects.map((project) => [project.id, project]));
const contentByPath = new Map<string, {
  projectId: string;
  projectTitle: string;
  title: string;
  kind: 'chapter' | 'supplement' | 'document';
  href: string;
}>();

for (const entry of chapters) {
  const project = projects.find((candidate) => entry.id.startsWith(projectIdPrefix(candidate.id, 'chapters')));
  if (!project) continue;
  const relative = entry.id.slice(project.id.length + 1);
  contentByPath.set('content/projects/' + entry.id + '.md', {
    projectId: project.id,
    projectTitle: project.data.title,
    title: entry.data.title,
    kind: 'chapter',
    href: '/projetos/' + project.id + '/documentacao/' + relative + '/',
  });
}
for (const entry of supplements) {
  const project = projects.find((candidate) => entry.id.startsWith(projectIdPrefix(candidate.id, 'supplements')));
  if (!project) continue;
  const relative = entry.id.slice(project.id.length + 1);
  contentByPath.set('content/projects/' + entry.id + '.md', {
    projectId: project.id,
    projectTitle: project.data.title,
    title: entry.data.title,
    kind: 'supplement',
    href: '/projetos/' + project.id + '/documentacao/' + relative + '/',
  });
}
for (const entry of documents) {
  const project = projectById.get(entry.id);
  if (!project) continue;
  contentByPath.set('content/projects/' + entry.id + '/document.md', {
    projectId: project.id,
    projectTitle: project.data.title,
    title: entry.data.title,
    kind: 'document',
    href: '/projetos/' + project.id + '/documentacao/',
  });
}

function projectIdPrefix(projectId: string, group: string) {
  return projectId + '/' + group + '/';
}

type CommitRecord = {
  sha: string;
  date: Date;
  paths: Array<{ path: string; additions: number; deletions: number }>;
};

let recentUpdates: Array<{
  projectTitle: string;
  title: string;
  kind: 'chapter' | 'supplement' | 'document';
  date: Date;
  href: string;
}> = [];

try {
  // Percorre o histórico dos arquivos de projeto, não os commits gerais do repositório.
  // A primeira alteração relevante de cada documento é a mais recente; mudanças pequenas
  // não escondem a última atualização substancial daquele mesmo documento.
  const repositoryRoot = execFileSync('git', ['rev-parse', '--show-toplevel'], {
    cwd: process.cwd(), encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'],
  }).trim();

  const log = execFileSync('git', [
    'log', '-n', '250', '--no-merges', '--format=COMMIT:%H%x09%cI',
    '--numstat', '--', 'content/projects',
  ], { cwd: repositoryRoot, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });

  const latestRelevantByPath = new Map<string, {
    sha: string;
    date: Date;
    additions: number;
    deletions: number;
  }>();
  let current: CommitRecord | null = null;

  const considerCommit = (commit: CommitRecord | null) => {
    if (!commit) return;
    for (const changed of commit.paths) {
      if (!changed.path.endsWith('.md') || latestRelevantByPath.has(changed.path)) continue;
      if (changed.additions + changed.deletions < 12) continue;
      latestRelevantByPath.set(changed.path, {
        sha: commit.sha,
        date: commit.date,
        additions: changed.additions,
        deletions: changed.deletions,
      });
    }
  };

  for (const line of log.split('\n')) {
    if (line.startsWith('COMMIT:')) {
      considerCommit(current);
      const [sha, date] = line.slice('COMMIT:'.length).split('\t');
      current = { sha, date: new Date(date), paths: [] };
      continue;
    }
    if (!current || !line.includes('\t')) continue;
    const [added, removed, ...pathParts] = line.split('\t');
    const path = pathParts.join('\t');
    if (!path.startsWith('content/projects/')) continue;
    current.paths.push({
      path,
      additions: added === '-' ? 0 : Number(added) || 0,
      deletions: removed === '-' ? 0 : Number(removed) || 0,
    });
  }
  considerCommit(current);

  recentUpdates = [...latestRelevantByPath.entries()]
    .map(([path, change]) => {
      const content = contentByPath.get(path);
      if (!content) return null;
      return {
        projectTitle: content.projectTitle,
        title: content.title,
        kind: content.kind,
        date: change.date,
        href: withBase(content.href),
      };
    })
    .filter((update): update is NonNullable<typeof update> => update !== null)
    .sort((a, b) => b.date.getTime() - a.date.getTime())
    .slice(0, 5);
} catch {
  // Sem histórico Git disponível, o slider não terá entradas.
}

// Conta as tags utilizadas nos posts
const tagCounts = new Map<string, number>();

for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<BaseLayout
  title="Início"
  description="Alison · estudante de engenharia da computação. Arquivo de coisas que estou aprendendo, construindo e tentando entender."
>
  <section class="container hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-greeting">Olá, eu sou o Alison</p>

        <p class="hero-bio">
          Estudante de engenharia da computação
        </p>

        <div class="now">
          <h2>Agora</h2>
          <ul>
            <li>Provavelmente mestrando um RPG ou fazendo um projeto besta</li>
          </ul>
        </div>
      </div>

      <div class="hero-photo">
        <img src={withBase('/perfil.png')} alt="Foto de Alison" />
      </div>
    </div>
  </section>

  <div class="container home-layout">

    <div class="home-main">
      <section class="section">

        <h2 class="section-title">
          Posts recentes
          <span class="more">
            <a href={withBase('/archive')}>ver todos →</a>
          </span>
        </h2>

        <EntryList entries={recentPosts} />

      </section>
    </div>

    <aside class="sidebar" aria-label="Barra lateral">

      <!-- NOVIDADES -->
      <section class="widget updates-widget">
        <h2 class="widget-title">Novidades</h2>
        <div class="widget-body updates-widget-body">
          {recentUpdates.length > 0 ? (
            <div class="updates-list">
              {recentUpdates.slice(0, 3).map((update, index) => (
                <a class="update-entry" href={update.href}>
                  <div class="update-entry-heading">
                    <span class:list={['update-kind', { 'update-kind-chapter': update.kind === 'chapter' }]}>
                      {update.kind === 'chapter' ? 'NOVO CAPÍTULO' : 'ATUALIZAÇÃO'}
                    </span>
                    <span class="update-index">{String(index + 1).padStart(2, '0')}</span>
                  </div>
                  <span class="update-entry-title">{update.title}</span>
                  <span class="update-entry-project">{update.projectTitle}</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="widget-muted updates-empty">Nenhuma novidade recente.</p>
          )}
          <a class="updates-more" href={withBase('/projetos')}>explorar projetos <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <!-- NAVEGAÇÃO -->
      <section class="widget">
        <h2 class="widget-title">Navegação</h2>

        <div class="widget-body">
          <ul class="sidebar-links">
            <li>
              <a href={withBase('/')}>Início</a>
            </li>

            <li>
              <a href={withBase('/archive')}>Arquivo</a>
            </li>

            <li>
              <a href={withBase('/projetos')}>Projetos</a>
            </li>

            <li>
              <a href={withBase('/about')}>Sobre</a>
            </li>
          </ul>
        </div>
      </section>

      <!-- TAGS -->
      <section class="widget">
        <h2 class="widget-title">Tags</h2>

        <div class="widget-body">

          {tags.length > 0 ? (
            <div class="tag-cloud">
              {tags.map(([tag, count]) => (
                <span class="sidebar-tag">
                  #{tag}
                  <small>{count}</small>
                </span>
              ))}
            </div>
          ) : (
            <p class="widget-muted">
              Ainda não existem tags.
            </p>
          )}

        </div>
      </section>


      <!-- LINKS -->
      <section class="widget">
        <h2 class="widget-title">Links</h2>

        <div class="widget-body">
          <ul class="sidebar-links">

            <li>
              <a
                href="https://github.com/ABMS-NS"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub ↗
              </a>
            </li>

            <li>
              <a href={withBase('/projetos')}>
                Projetos
              </a>
            </li>

          </ul>
        </div>
      </section>


      <!-- STATUS -->
      <section class="widget widget-status">
        <h2 class="widget-title">Status</h2>

        <div class="widget-body">

          <p>
            <span class="status-dot"></span>
            online
          </p>

          <p class="widget-muted">
            última atualização: 2026
          </p>

        </div>
      </section>

    </aside>

  </div>

<style>
  .updates-widget-body { padding: 0.45rem 0.65rem 0.6rem; }
  .updates-list { display: grid; }
  .update-entry {
    display: grid; gap: 0.28rem; min-width: 0; padding: 0.75rem 0.15rem;
    border-bottom: 1px solid var(--border-rest); color: var(--text-primary);
    text-decoration: none; transition: background-color 140ms ease, padding 140ms ease;
  }
  .update-entry:first-child { padding-top: 0.35rem; }
  .update-entry:last-child { border-bottom: 0; }
  .update-entry:hover,
  .update-entry:focus-visible {
    padding-right: 0.4rem; padding-left: 0.4rem;
    background: var(--bg-elevated);
  }
  .update-entry:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 2px; }
  .update-entry-heading { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .update-kind {
    color: var(--text-secondary); font-size: 0.59rem; font-weight: 700;
    letter-spacing: 0.075em; line-height: 1.3;
  }
  .update-kind-chapter { color: var(--accent); }
  .update-index { color: var(--text-muted, var(--text-secondary)); font-size: 0.62rem; font-variant-numeric: tabular-nums; }
  .update-entry-title {
    overflow-wrap: anywhere; color: var(--text-primary); font-size: 0.82rem;
    font-weight: 650; line-height: 1.35;
  }
  .update-entry-project { color: var(--text-secondary); font-size: 0.7rem; line-height: 1.3; }
  .update-entry:hover .update-entry-title,
  .update-entry:focus-visible .update-entry-title { color: var(--accent); }
  .updates-more {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    margin-top: 0.45rem; padding: 0.45rem 0.15rem 0.1rem;
    border-top: 1px solid var(--border-rest); color: var(--text-secondary);
    font-size: 0.68rem; text-decoration: none;
  }
  .updates-more:hover { color: var(--accent); }
  .updates-empty { margin: 0.4rem 0 0.7rem; font-size: 0.75rem; }
</style>
>




</BaseLayout>
