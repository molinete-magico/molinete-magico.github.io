---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const projects = (await getCollection('projects', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'pt-BR'));

const groups = [
  {
    key: 'rpg',
    label: 'Sistemas e jogos',
    description: 'Regras, experiências e mundos jogáveis.',
    items: projects.filter((project) => project.data.type === 'rpg'),
  },
  {
    key: 'story',
    label: 'Narrativas e outros mundos',
    description: 'Histórias, personagens e universos em construção.',
    items: projects.filter((project) => project.data.type === 'story'),
  },
];
---

<BaseLayout
  title="Projetos"
  description="Um arquivo de sistemas, histórias e mundos em construção."
  canonicalPath="/projetos"
>
  <section class="container projects-page">
    <header class="projects-header">
      <div class="projects-heading">
        <p class="projects-kicker"><span class="status-dot" aria-hidden="true"></span> Arquivo pessoal / Projetos</p>
        <h1>Projetos</h1>
        <p class="projects-intro">
          Sistemas, histórias, ideias e mundos em construção. Cada projeto reúne seus próprios textos,
          documentos e materiais em um só lugar.
        </p>
      </div>
      <div class="projects-stats" aria-label="Resumo do arquivo">
        <div class="stat">
          <span class="stat-value">{projects.length.toString().padStart(2, '0')}</span>
          <span class="stat-label">Projetos</span>
        </div>
        <div class="stat">
          <span class="stat-value">{groups.filter((group) => group.items.length > 0).length.toString().padStart(2, '0')}</span>
          <span class="stat-label">Coleções</span>
        </div>
      </div>
    </header>

    {projects.length > 0 ? (
      <>
        <div class="project-tools">
          <label for="project-search-input">Pesquisar no arquivo</label>
          <div class="search-control">
            <span aria-hidden="true" class="search-prefix">&gt;_</span>
            <input id="project-search-input" type="search" placeholder="Nome, descrição ou categoria..." autocomplete="off" />
          </div>
          <p id="project-search-count" class="search-count" aria-live="polite">{projects.length} projetos encontrados</p>
        </div>

        <div class="project-collections" id="project-collections">
          {groups.map((group, groupIndex) => group.items.length > 0 && (
            <section class="project-collection widget" data-collection={group.key} aria-labelledby={`collection-${group.key}`}>
              <header class="widget-title collection-title">
                <span>{group.label}</span>
                <span class="collection-count">{group.items.length.toString().padStart(2, '0')}</span>
              </header>
              <div class="collection-description">
                <span class="collection-index">[ {groupIndex === 0 ? '01' : '02'} ]</span>
                <p>{group.description}</p>
              </div>
              <ol class="project-list">
                {group.items.map((project) => (
                  <li
                    class="project-entry"
                    data-search={`${project.data.title} ${project.data.description ?? ''} ${project.data.type === 'rpg' ? 'sistema de rpg rpg jogos' : 'história narrativa conto ficção'}`}
                  >
                    <a
                      class:list={['project-entry-link', { 'has-banner': Boolean(project.data.cover) }]}
                      href={withBase(`/projetos/${project.id}/`)}
                      style={project.data.cover ? `--project-banner: url("${withBase(project.data.cover)}"); --banner-position: ${project.data.bannerPosition ?? '50%'};` : undefined}
                    >
                      <span class="project-number">{(projects.indexOf(project) + 1).toString().padStart(2, '0')}</span>
                      <span class="project-copy">
                        <span class="project-type">{project.data.type === 'rpg' ? 'Sistema de RPG' : 'Narrativa'}</span>
                        <span class="project-title">{project.data.title}</span>
                        {project.data.description && <span class="project-description">{project.data.description}</span>}
                      </span>
                      <span class="project-open">Abrir <span aria-hidden="true">↗</span></span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
        <p id="project-search-empty" class="projects-empty" hidden>Nenhum projeto corresponde à sua busca.</p>
      </>
    ) : (
      <div class="projects-empty projects-empty--initial widget">
        <p class="widget-title">Arquivo em aberto</p>
        <div class="widget-body">
          <p>Quando você publicar um sistema de RPG ou uma história pelo Writer, ele aparecerá aqui.</p>
        </div>
      </div>
    )}

    <p class="projects-footer"><span>FIM DO ÍNDICE</span><span>Molinete Mágico · arquivo em construção</span></p>
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#project-search-input');
  const projectEntries = Array.from(document.querySelectorAll<HTMLElement>('.project-entry'));
  const collections = Array.from(document.querySelectorAll<HTMLElement>('.project-collection'));
  const count = document.querySelector<HTMLElement>('#project-search-count');
  const empty = document.querySelector<HTMLElement>('#project-search-empty');

  const normalize = (value: string) =>
    value.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLocaleLowerCase('pt-BR');

  searchInput?.addEventListener('input', () => {
    const query = normalize(searchInput.value.trim());
    let visible = 0;

    for (const entry of projectEntries) {
      const matches = normalize(entry.dataset.search ?? '').includes(query);
      entry.hidden = !matches;
      if (matches) visible++;
    }

    for (const collection of collections) {
      collection.hidden = !collection.querySelector('.project-entry:not([hidden])');
    }

    if (count) count.textContent = visible === 1 ? '1 projeto encontrado' : `${visible} projetos encontrados`;
    if (empty) empty.hidden = visible !== 0;
  });
</script>

<style>
  .projects-page {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }

  .projects-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-6);
    padding: var(--space-5);
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.28);
  }

  .projects-kicker,
  .stat-label,
  .project-tools label,
  .search-count,
  .collection-index,
  .project-number,
  .project-type,
  .project-open,
  .projects-footer {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.045em;
  }

  .projects-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .projects-kicker .status-dot {
    flex: 0 0 auto;
  }

  .projects-heading h1 {
    margin: 0;
    color: var(--accent);
    font-size: clamp(2rem, 5vw, 3.15rem);
    line-height: 1.12;
  }

  .projects-intro {
    max-width: 48rem;
    margin-top: var(--space-3);
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .projects-stats {
    display: flex;
    gap: var(--space-4);
    align-items: stretch;
  }

  .stat {
    display: flex;
    min-width: 5.4rem;
    flex-direction: column;
    justify-content: center;
    padding-left: var(--space-3);
    border-left: 1px solid var(--border-rest);
  }

  .stat-value {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .stat-label {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: 0.62rem;
  }

  .project-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0;
  }

  .project-tools label {
    grid-column: 1 / -1;
    color: var(--text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .search-control {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.7rem;
    padding: 0 var(--space-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border-rest);
  }

  .search-prefix {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .search-control input {
    width: 100%;
    min-width: 0;
    padding: 0;
    color: var(--text-primary);
    background: transparent;
    border: 0;
    outline: 0;
    font: inherit;
  }

  .search-control:focus-within {
    border-color: var(--border-focus);
    outline: 1px solid var(--border-focus);
    outline-offset: 2px;
  }

  .search-control input::placeholder {
    color: var(--text-muted);
    opacity: 0.8;
  }

  .search-count {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.62rem;
    white-space: nowrap;
  }

  .project-collections {
    display: grid;
    gap: var(--space-6);
  }

  .project-collection {
    min-width: 0;
  }

  .collection-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .collection-count {
    color: var(--text-primary);
    font-size: 0.72rem;
  }

  .collection-description {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border-rest);
  }

  .collection-index {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 0.64rem;
  }

  .collection-description p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-entry {
    min-width: 0;
    border-bottom: 1px solid var(--border-rest);
  }

  .project-entry:last-child {
    border-bottom: 0;
  }

  .project-entry-link {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 6.6rem;
    padding: var(--space-4) var(--space-3);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    isolation: isolate;
    transition: background-color 120ms ease;
  }

  .project-entry-link:hover {
    color: inherit;
    background: var(--bg-soft);
    text-shadow: none;
  }

  .project-entry-link:focus-visible {
    z-index: 2;
  }

  .project-entry-link.has-banner::before {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    width: min(42%, 22rem);
    height: 100%;
    content: "";
    background-image: var(--project-banner);
    background-size: cover;
    background-position: center var(--banner-position, 50%);
    background-repeat: no-repeat;
    opacity: 0.3;
    -webkit-mask-image: linear-gradient(to left, black 0%, black 30%, transparent 100%);
    mask-image: linear-gradient(to left, black 0%, black 30%, transparent 100%);
    pointer-events: none;
    transition: opacity 120ms ease;
  }

  .project-entry-link.has-banner:hover::before {
    opacity: 0.45;
  }

  .project-number {
    align-self: start;
    padding-top: 0.15rem;
    color: var(--text-muted);
    font-size: 0.65rem;
  }

  .project-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .project-type {
    color: var(--text-muted);
    font-size: 0.62rem;
  }

  .project-title {
    margin-top: 0.15rem;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .project-entry-link:hover .project-title {
    color: var(--accent);
    text-shadow: 0 0 6px var(--glow-soft);
  }

  .project-description {
    max-width: 72ch;
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .project-open {
    color: var(--text-muted);
    font-size: 0.62rem;
    white-space: nowrap;
  }

  .project-open span {
    display: inline-block;
    color: var(--accent);
    transition: transform 120ms ease;
  }

  .project-entry-link:hover .project-open span {
    transform: translate(2px, -2px);
  }

  .projects-empty {
    margin-top: var(--space-6);
    padding: var(--space-4);
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px dashed var(--border-rest);
  }

  .projects-empty--initial {
    padding: 0;
  }

  .projects-empty--initial .widget-body {
    margin: 0;
  }

  .projects-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-2);
    border-top: 1px dotted var(--border-rest);
    color: var(--text-muted);
    font-size: 0.6rem;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 650px) {
    .projects-page {
      padding-top: var(--space-4);
    }

    .projects-header {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .projects-stats {
      gap: var(--space-3);
    }

    .stat {
      min-width: 4.8rem;
    }

    .project-tools {
      grid-template-columns: 1fr;
    }

    .search-count {
      justify-self: start;
    }

    .project-entry-link {
      grid-template-columns: 1.6rem minmax(0, 1fr);
      gap: var(--space-2);
      min-height: 6rem;
      padding-inline: var(--space-2);
    }

    .project-open {
      display: none;
    }

    .project-entry-link.has-banner::before {
      width: 62%;
      opacity: 0.22;
    }

    .projects-footer {
      flex-direction: column;
      gap: var(--space-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-entry-link,
    .project-entry-link::before,
    .project-open span {
      transition: none;
    }
  }
</style>
