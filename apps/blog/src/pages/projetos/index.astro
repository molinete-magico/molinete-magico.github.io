---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const projects = (await getCollection('projects', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'pt-BR'));

const groups = [
  {
    key: 'rpg',
    label: 'Sistemas e jogos',
    description: 'Regras, experiências e mundos jogáveis.',
    items: projects.filter((project) => project.data.type === 'rpg'),
  },
  {
    key: 'story',
    label: 'Narrativas e outros mundos',
    description: 'Histórias, personagens e universos em construção.',
    items: projects.filter((project) => project.data.type === 'story'),
  },
];
---

<BaseLayout
  title="Projetos"
  description="Um arquivo de sistemas, histórias e mundos em construção."
  canonicalPath="/projetos"
>
  <section class="container projects-page">
    <header class="projects-heading">
      <p class="projects-eyebrow">Caderno de criação <span> / </span> Arquivo</p>
      <h1>Projetos<span class="heading-period">.</span></h1>
      <p class="projects-intro">
        Um espaço para sistemas, histórias, ideias e mundos em construção.
        Cada projeto reúne seus próprios textos e materiais.
      </p>
      <div class="projects-summary" aria-label="Resumo do arquivo">
        <span>{projects.length.toString().padStart(2, '0')} projetos</span>
        <span class="summary-divider" aria-hidden="true">/</span>
        <span>{groups.filter((group) => group.items.length > 0).length.toString().padStart(2, '0')} coleções</span>
      </div>
    </header>

    {projects.length > 0 ? (
      <>
        <div class="project-search">
          <label for="project-search-input">Pesquisar no arquivo</label>
          <input id="project-search-input" type="search" placeholder="Nome, descrição ou categoria..." autocomplete="off" />
          <p id="project-search-count" class="search-count" aria-live="polite">{projects.length} projetos</p>
        </div>

        <div class="project-collections" id="project-collections">
          {groups.map((group) => group.items.length > 0 && (
            <section class="project-collection" data-collection={group.key} aria-labelledby={`collection-${group.key}`}>
              <header class="collection-heading">
                <div>
                  <p class="collection-index">{group.key === 'rpg' ? '01' : '02'} <span>/</span> Coleção</p>
                  <h2 id={`collection-${group.key}`}>{group.label}</h2>
                  <p>{group.description}</p>
                </div>
                <span class="collection-count">{group.items.length.toString().padStart(2, '0')}</span>
              </header>

              <ol class="project-list">
                {group.items.map((project) => (
                  <li
                    class="project-entry"
                    data-search={`${project.data.title} ${project.data.description ?? ''} ${project.data.type === 'rpg' ? 'sistema de rpg rpg jogos' : 'história narrativa conto ficção'}`}
                  >
                    <a
                      class:list={['project-entry-link', { 'has-banner': Boolean(project.data.cover) }]}
                      href={withBase(`/projetos/${project.id}/`)}
                      style={project.data.cover ? `--project-banner: url("${withBase(project.data.cover)}"); --banner-position: ${project.data.bannerPosition ?? '50%'};` : undefined}
                    >
                      <span class="project-number">{(projects.indexOf(project) + 1).toString().padStart(2, '0')}</span>
                      <span class="project-copy">
                        <span class="project-type">{project.data.type === 'rpg' ? 'Sistema de RPG' : 'História'}</span>
                        <span class="project-title">{project.data.title}</span>
                        {project.data.description && <span class="project-description">{project.data.description}</span>}
                        <span class="project-open">Explorar projeto <span aria-hidden="true">↗</span></span>
                      </span>
                      <span class="project-arrow" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
        <p id="project-search-empty" class="projects-empty" hidden>Nenhum projeto corresponde à sua busca.</p>
      </>
    ) : (
      <div class="projects-empty projects-empty--initial">
        <p class="empty-label">[ ARQUIVO EM ABERTO ]</p>
        <p>Quando você publicar um sistema de RPG ou uma história pelo Writer, ele aparecerá aqui.</p>
      </div>
    )}
    <footer class="projects-footer">
      <span>Molinete Mágico</span>
      <span>Um arquivo em constante construção</span>
    </footer>
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#project-search-input');
  const projectEntries = Array.from(document.querySelectorAll<HTMLElement>('.project-entry'));
  const collections = Array.from(document.querySelectorAll<HTMLElement>('.project-collection'));
  const count = document.querySelector<HTMLElement>('#project-search-count');
  const empty = document.querySelector<HTMLElement>('#project-search-empty');

  const normalize = (value: string) =>
    value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('pt-BR');

  searchInput?.addEventListener('input', () => {
    const query = normalize(searchInput.value.trim());
    let visible = 0;

    for (const entry of projectEntries) {
      const matches = normalize(entry.dataset.search ?? '').includes(query);
      entry.hidden = !matches;
      if (matches) visible++;
    }

    for (const collection of collections) {
      collection.hidden = !collection.querySelector('.project-entry:not([hidden])');
    }

    if (count) count.textContent = visible === 1 ? '1 projeto' : `${visible} projetos`;
    if (empty) empty.hidden = visible !== 0;
  });
</script>

<style>
  .projects-page {
    padding-bottom: var(--space-8);
  }

  .projects-heading {
    max-width: 48rem;
    padding: var(--space-5) 0 var(--space-6);
    border-bottom: 1px solid var(--border-rest);
  }

  .projects-eyebrow,
  .collection-index,
  .project-type,
  .project-number,
  .projects-summary,
  .search-count,
  .projects-footer,
  .empty-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }

  .projects-eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .projects-eyebrow span,
  .collection-index span,
  .summary-divider {
    color: var(--text-muted);
    opacity: 0.55;
  }

  .projects-heading h1 {
    margin: 0;
    font-size: clamp(2.7rem, 7vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .heading-period {
    color: var(--text-muted);
  }

  .projects-intro {
    max-width: 38rem;
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  .projects-summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .project-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-5) 0 var(--space-7);
    max-width: 48rem;
  }

  .project-search label {
    grid-column: 1 / -1;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .project-search input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    color: var(--text-primary);
    background: var(--bg-elevated);
    border: 1px solid var(--border-rest);
    border-radius: 0;
    font: inherit;
  }

  .project-search input:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .search-count {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .project-collections {
    max-width: 58rem;
  }

  .project-collection {
    margin-top: var(--space-7);
  }

  .collection-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-rest);
  }

  .collection-index {
    margin: 0 0 var(--space-2);
    color: var(--text-muted);
    font-size: 0.66rem;
  }

  .collection-heading h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    letter-spacing: -0.025em;
  }

  .collection-heading p:not(.collection-index) {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: 0.84rem;
  }

  .collection-count {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-entry {
    min-width: 0;
    border-bottom: 1px solid var(--border-rest);
  }

  .project-entry-link {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    align-items: center;
    gap: var(--space-3);
    min-height: 9.5rem;
    padding: var(--space-4) var(--space-2);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    isolation: isolate;
    transition: background-color 140ms ease, padding 140ms ease;
  }

  .project-entry-link:hover {
    padding-right: var(--space-3);
    padding-left: var(--space-3);
    color: inherit;
    background: var(--bg-soft);
    text-shadow: none;
  }

  .project-entry-link.has-banner::before {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    width: min(42%, 22rem);
    height: 100%;
    content: "";
    background-image: var(--project-banner);
    background-size: cover;
    background-position: center var(--banner-position, 50%);
    background-repeat: no-repeat;
    opacity: 0.34;
    -webkit-mask-image: linear-gradient(to left, black 0%, black 34%, transparent 100%);
    mask-image: linear-gradient(to left, black 0%, black 34%, transparent 100%);
    pointer-events: none;
    transition: opacity 140ms ease;
  }

  .project-entry-link.has-banner:hover::before {
    opacity: 0.48;
  }

  .project-number {
    align-self: start;
    padding-top: 0.25rem;
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .project-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .project-type {
    color: var(--text-muted);
    font-size: 0.64rem;
  }

  .project-title {
    margin-top: var(--space-1);
    font-size: clamp(1.12rem, 2.4vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .project-description {
    max-width: 39rem;
    margin-top: var(--space-2);
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .project-open {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.025em;
  }

  .project-open span,
  .project-arrow {
    transition: transform 140ms ease, color 140ms ease;
  }

  .project-arrow {
    justify-self: end;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .project-entry-link:hover .project-arrow {
    color: var(--text-primary);
    transform: translate(2px, -2px);
  }

  .projects-empty {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px dashed var(--border-rest);
    color: var(--text-muted);
  }

  .projects-empty p:last-child {
    margin-bottom: 0;
  }

  .empty-label {
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .projects-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 58rem;
    margin-top: var(--space-8);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-rest);
    color: var(--text-muted);
    font-size: 0.62rem;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 650px) {
    .projects-heading {
      padding-top: var(--space-3);
    }

    .project-search {
      grid-template-columns: 1fr;
    }

    .search-count {
      justify-self: start;
    }

    .project-entry-link {
      grid-template-columns: 1.8rem minmax(0, 1fr) 1rem;
      gap: var(--space-2);
      min-height: 8.5rem;
      padding-right: 0;
      padding-left: 0;
    }

    .project-entry-link.has-banner::before {
      width: 58%;
      opacity: 0.24;
    }

    .project-description {
      max-width: 100%;
    }

    .projects-footer {
      flex-direction: column;
      gap: var(--space-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-entry-link,
    .project-entry-link::before,
    .project-arrow,
    .project-open span {
      transition: none;
    }
  }
</style>
