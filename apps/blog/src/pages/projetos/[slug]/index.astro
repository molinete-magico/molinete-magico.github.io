---
import { getCollection, render } from 'astro:content';
import EntryList from '../../../components/EntryList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../lib/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.published);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.project === project.id))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const [documents, chapters, supplements] = await Promise.all([
  getCollection('projectDocs', ({ data }) => data.published),
  getCollection('projectChapters', ({ data }) => data.published),
  getCollection('projectSupplements', ({ data }) => data.published),
]);
const hasReader = documents.some((document) => document.id === project.id)
  || chapters.some((page) => page.id.startsWith(`${project.id}/chapters/`))
  || supplements.some((page) => page.id.startsWith(`${project.id}/supplements/`));
const kind = project.data.type === 'rpg' ? 'Sistema de RPG' : 'História';
---

<BaseLayout
  title={project.data.title}
  description={project.data.description || `Projeto: ${project.data.title}`}
  canonicalPath={`/projetos/${project.id}`}
>
  <article class="container project-page">
    <p class="project-breadcrumb"><a href={withBase('/projetos')}>← Todos os projetos</a></p>
    {project.data.cover && (
      <div class="project-hero-cover">
        <img src={withBase(project.data.cover)} alt="" style={`object-position: center ${project.data.bannerPosition ?? '50%'};`} />
      </div>
    )}
    <header class="post-header">
      <p class="project-type">{kind}</p>
      <h1>{project.data.title}</h1>
      {project.data.description && <p class="post-meta">{project.data.description}</p>}
    </header>
    {project.data.showHomepage && (
      <div class="post-body project-homepage">
        <div class="prose">
          <Content />
        </div>
      </div>
    )}
    {hasReader && (
      <section class="project-reader-link" aria-labelledby="project-reader-title">
        <div>
          <p class="project-type">LEITURA DO PROJETO</p>
          <h2 id="project-reader-title">Capítulos e documentação</h2>
          <p>Leia o conteúdo principal, navegue pelo sumário e explore os materiais complementares.</p>
        </div>
        <a href={withBase(`/projetos/${project.id}/documentacao/`)}>Abrir leitor →</a>
      </section>
    )}
    <section class="project-documents" aria-labelledby="project-posts-title">
      <div class="project-section-heading">
        <h2 id="project-posts-title">Publicações do projeto</h2>
      </div>
      {posts.length > 0 ? (
        <EntryList entries={posts} />
      ) : (
        <p class="post-meta">Ainda não há posts associados a este projeto. Para associar uma publicação, use <code>project: "{project.id}"</code> no frontmatter do post.</p>
      )}
    </section>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-bottom: var(--space-8);
  }

  .project-breadcrumb {
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .project-type {
    margin: 0 0 var(--space-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-hero-cover {
    max-height: 24rem;
    overflow: hidden;
    border: 1px solid var(--border-rest);
    background: var(--bg-soft);
  }

  .project-hero-cover img {
    display: block;
    width: 100%;
    max-height: 24rem;
    object-fit: cover;
    object-position: center 50%;
  }

  .project-homepage {
    margin-top: var(--space-6);
  }

  .project-reader-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-rest);
    border-bottom: 1px solid var(--border-rest);
  }

  .project-reader-link h2 {
    margin: 0;
  }

  .project-reader-link p:not(.project-type) {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .project-reader-link > a {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .project-documents {
    margin-top: var(--space-8);
  }

  .project-documents h2 {
    margin-top: 0;
  }

  .project-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .project-section-heading h2 {
    margin-bottom: 0;
  }

  @media (max-width: 650px) {
    .project-section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-reader-link {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-hero-cover img {
      max-height: 14rem;
    }
  }
</style>
