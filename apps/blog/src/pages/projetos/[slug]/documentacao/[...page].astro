---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { withBase } from '../../../../lib/paths';

export async function getStaticPaths() {
  const [projects, chapters, supplements] = await Promise.all([
    getCollection('projects', ({ data }) => data.published),
    getCollection('projectChapters', ({ data }) => data.published),
    getCollection('projectSupplements', ({ data }) => data.published),
  ]);
  const projectsById = new Map(projects.map((project) => [project.id, project] as const));
  const entries = [
    ...chapters.map((entry) => ({ entry, group: 'chapters' as const })),
    ...supplements.map((entry) => ({ entry, group: 'supplements' as const })),
  ];

  return entries.flatMap(({ entry, group }) => {
    const project = projects.find((candidate) => entry.id.startsWith(`${candidate.id}/${group}/`));
    if (!project || !projectsById.has(project.id)) return [];
    return [{
      params: {
        slug: project.id,
        page: entry.id.slice(project.id.length + 1),
      },
      props: { entry, project, group },
    }];
  });
}

const { entry, project, group } = Astro.props;
const { Content, headings } = await render(entry);
const youtubeVideoId = (value?: string) => {
  if (!value) return null;
  try {
    const url = new URL(value);
    const host = url.hostname.toLowerCase();
    if (!['youtube.com', 'www.youtube.com', 'music.youtube.com', 'm.youtube.com', 'youtu.be', 'www.youtu.be'].includes(host)) return null;
    const candidate = host.endsWith('youtu.be')
      ? url.pathname.split('/').filter(Boolean)[0]
      : url.searchParams.get('v') || url.pathname.match(/^\/(?:embed|shorts)\/([^/?]+)/)?.[1];
    return candidate && /^[a-zA-Z0-9_-]{11}$/.test(candidate) ? candidate : null;
  } catch {
    return null;
  }
};
const musicVideoId = youtubeVideoId(entry.data.youtubeMusic);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const [documentEntries, allChapters, allSupplements] = await Promise.all([
  getCollection('projectDocs', ({ data }) => data.published),
  getCollection('projectChapters', ({ data }) => data.published),
  getCollection('projectSupplements', ({ data }) => data.published),
]);
const mainDocument = documentEntries.find((document) => document.id === project.id);
const chapters = allChapters
  .filter((page) => page.id.startsWith(`${project.id}/chapters/`))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'pt-BR'));
const supplements = allSupplements
  .filter((page) => page.id.startsWith(`${project.id}/supplements/`))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'pt-BR'));
const pageUrl = (id: string) => withBase(`/projetos/${project.id}/documentacao/${id.slice(project.id.length + 1)}/`);
const currentList = group === 'chapters' ? chapters : supplements;
const currentIndex = currentList.findIndex((page) => page.id === entry.id);
const previousPage = currentIndex > 0 ? currentList[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < currentList.length - 1 ? currentList[currentIndex + 1] : null;
---

<BaseLayout
  title={`${entry.data.title} — ${project.data.title}`}
  description={`Conteúdo de ${project.data.title}: ${entry.data.title}`}
  canonicalPath={`/projetos/${project.id}/documentacao/${entry.id.slice(project.id.length + 1)}`}
>
  <article class="container project-document-page">
    <p class="document-breadcrumb">
      <a href={withBase(`/projetos/${project.id}/`)}>← Voltar ao projeto</a>
      <span aria-hidden="true">/</span>
      <a href={withBase(`/projetos/${project.id}/documentacao/`)}>{project.data.title}</a>
    </p>

    <header class="document-header">
      <p class="document-eyebrow">
        {group === 'chapters' ? 'CAPÍTULO' : 'COMPLEMENTO'} / {project.data.type === 'rpg' ? 'SISTEMA DE RPG' : 'HISTÓRIA'}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="document-project-title">{project.data.title}</p>
    </header>

    <div class="project-doc-layout">
      <aside class="document-sidebar">
        <nav class="document-toc" aria-label="Sumário do projeto">
        <p class="toc-title">Sumário</p>
        {mainDocument && (
          <a class="toc-main-link" href={withBase(`/projetos/${project.id}/documentacao/`)}>{mainDocument.data.title}</a>
        )}
        {chapters.length > 0 && (
          <section class="toc-group" aria-labelledby="toc-chapters">
            <p id="toc-chapters" class="toc-group-title">Capítulos</p>
            <ol>
              {chapters.map((page) => (
                <li>
                  <a class:list={{ 'toc-current': page.id === entry.id }} aria-current={page.id === entry.id ? 'page' : undefined} href={pageUrl(page.id)}>{page.data.title}</a>
                </li>
              ))}
            </ol>
          </section>
        )}
        {supplements.length > 0 && (
          <section class="toc-group" aria-labelledby="toc-supplements">
            <p id="toc-supplements" class="toc-group-title">Complementos</p>
            <ol>
              {supplements.map((page) => (
                <li>
                  <a class:list={{ 'toc-current': page.id === entry.id }} aria-current={page.id === entry.id ? 'page' : undefined} href={pageUrl(page.id)}>{page.data.title}</a>
                </li>
              ))}
            </ol>
          </section>
        )}
        {toc.length > 0 && (
          <section class="toc-group" aria-labelledby="toc-sections">
            <p id="toc-sections" class="toc-group-title">Nesta página</p>
            <ol class="toc-sections">
              {toc.map((heading) => (
                <li class:list={{ 'toc-subheading': heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </section>
        )}
        </nav>
        {musicVideoId && (
          <aside class="reading-music reading-music-desktop" aria-label="Trilha sonora sugerida">
            <p class="reading-music-label">Trilha sonora sugerida</p>
            <div class="reading-music-player">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${musicVideoId}`}
                title={`Trilha sonora sugerida para ${entry.data.title}`}
                loading="lazy"
                allow="encrypted-media; picture-in-picture"
              ></iframe>
            </div>
          </aside>
        )}
      </aside>

      <div class="document-content post-body">
        {musicVideoId && (
          <details class="reading-music-mobile" data-video-id={musicVideoId}>
            <summary>▶ Trilha sonora sugerida</summary>
            <div class="reading-music-player" data-player-host></div>
          </details>
        )}
        {musicVideoId && (
          <aside class="reading-music" aria-label="Sugestão de música para acompanhar a leitura">
            <p class="reading-music-label">Trilha sonora sugerida</p>
            <div class="reading-music-player">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${musicVideoId}`}
                title="Música sugerida para acompanhar a leitura"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </aside>
        )}
        <div class="prose">
          <Content />
        </div>
        <nav class="document-footer" aria-label="Navegação entre páginas">
          {previousPage ? <a href={pageUrl(previousPage.id)}>← {previousPage.data.title}</a> : <span />}
          {nextPage ? <a href={pageUrl(nextPage.id)}>{nextPage.data.title} →</a> : <a href={withBase(`/projetos/${project.id}/`)}>Página do projeto →</a>}
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.reading-music-mobile[data-video-id]').forEach((details) => {
    details.addEventListener('toggle', () => {
      if (!details.open) return;
      const host = details.querySelector<HTMLElement>('[data-player-host]');
      if (!host || host.querySelector('iframe')) return;
      const videoId = details.dataset.videoId;
      if (!videoId) return;
      const frame = document.createElement('iframe');
      frame.src = 'https://www.youtube-nocookie.com/embed/' + videoId;
      frame.title = 'Trilha sonora sugerida para acompanhar a leitura';
      frame.loading = 'lazy';
      frame.allow = 'encrypted-media; picture-in-picture';
      host.append(frame);
    });
  });
</script>

<style>
  .project-document-page { min-width: 0; padding-bottom: var(--space-8); }
  .document-breadcrumb {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-6); color: var(--text-muted);
    font-family: var(--font-mono); font-size: 0.78rem;
  }
  .document-header {
    margin-bottom: var(--space-6); padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-rest);
  }
  .document-eyebrow, .toc-title, .toc-group-title {
    margin: 0 0 var(--space-2); color: var(--text-muted);
    font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.06em; text-transform: uppercase;
  }
  .document-header h1 { margin: 0; }
  .document-project-title { margin: var(--space-2) 0 0; color: var(--text-muted); }
  .project-doc-layout {
    display: grid; min-width: 0; grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr);
    align-items: start; gap: clamp(calc(var(--space-5) + 20px), 4vw, calc(var(--space-8) + 20px));
  }
  .document-sidebar {
    position: sticky;
    top: var(--space-4);
    align-self: start;
    min-width: 0;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: var(--space-4);
    border-right: 1px solid var(--border-rest);
    overscroll-behavior: contain;
  }
  .document-toc { min-width: 0; }
  .document-toc ol { margin: 0; padding: 0; list-style: none; }
  .document-toc li { margin: 0; }
  .document-toc a {
    display: block; padding: 0.32rem 0; color: var(--text-secondary);
    font-size: 0.88rem; line-height: 1.45; text-decoration: none;
  }
  .document-toc a:hover { color: var(--text-primary); text-decoration: underline; text-underline-offset: 0.2em; }
  .document-toc .toc-main-link { display: block; padding: 0.32rem 0; color: var(--text-secondary); }
  .document-toc a.toc-current { color: var(--text-primary); font-weight: 600; }
  .toc-group { margin-top: var(--space-5); padding-top: var(--space-3); border-top: 1px solid var(--border-rest); }
  .toc-group-title { margin-bottom: var(--space-1); }
  .toc-sections { padding-left: var(--space-2) !important; }
  .document-toc .toc-subheading { padding-left: var(--space-3); }
  .document-toc .toc-subheading a { font-size: 0.82rem; }
  .document-content { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
  .document-content .prose { min-width: 0; max-width: none; padding-left: clamp(12px, 2vw, 24px); }
  .document-content .prose :global(img), .document-content .prose :global(video), .document-content .prose :global(iframe) { max-width: 100%; }
  .reading-music {
    min-width: 0;
    margin-top: var(--space-5);
    padding: var(--space-3);
    border: 1px solid var(--border-rest);
    background: var(--bg-elevated);
  }
  .reading-music-label {
    margin: 0 0 var(--space-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .reading-music-player {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
  }
  .reading-music-player iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .reading-music-mobile { display: none; }
  .reading-music-mobile summary {
    color: var(--text-secondary);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    list-style: none;
  }
  .reading-music-mobile summary::-webkit-details-marker { display: none; }
  .reading-music-mobile[open] .reading-music-player { margin-top: var(--space-3); }
  .document-content :global(h2), .document-content :global(h3) { scroll-margin-top: var(--space-6); }
  .document-footer {
    display: flex; justify-content: space-between; gap: var(--space-3);
    margin-top: var(--space-8); padding-top: var(--space-4);
    border-top: 1px solid var(--border-rest);
    font-family: var(--font-mono); font-size: 0.82rem;
  }
  .document-footer a { max-width: 48%; }
  @media (max-width: 760px) {
    .project-doc-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    .document-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0 0 var(--space-4);
      border-right: 0;
      border-bottom: 1px solid var(--border-rest);
    }
    .reading-music-desktop { display: none; }
    .reading-music-mobile {
      display: block;
      margin: 0 0 var(--space-4);
      padding: var(--space-3);
      border: 1px solid var(--border-rest);
      background: var(--bg-elevated);
    }
  }
</style>
