---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/paths';

const pathname = Astro.url.pathname;

// O site vive sob um subcaminho (base path); removemos esse prefixo
// do pathname para comparar com os links da navegação.
const currentPath = pathname.replace(import.meta.env.BASE_URL, '');

const links = [
  { href: withBase('/'), label: 'Início' },
  { href: withBase('/archive'), label: 'Arquivos' },
  { href: withBase('/projetos'), label: 'Projetos' },
  { href: withBase('/about'), label: 'Sobre' },
];

function isCurrent(link: string) {
  const target = link.replace(import.meta.env.BASE_URL, '');
  if (target === '/') return currentPath === '/';
  return currentPath.startsWith(target);
}
---

<header class="site-header">
  <nav class="container" aria-label="Navegação principal">
    <p class="brand"><a href={withBase('/')}>MOLINAS</a></p>
    <ul class="nav-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<script>
  // Não é necessário lógica extra aqui — o ThemeToggle tem o próprio script.
</script>
