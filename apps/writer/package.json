{
  "name": "writer",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:client && tsx src/server/standalone.ts",
    "check": "tsc --noEmit",
    "build:client": "esbuild src/client/main.ts --bundle --outdir=dist/client --format=esm --target=es2020 --minify",
    "build": "npm run build:client && node build.mjs",
    "start": "node dist/writer.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@hono/node-server": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.8",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
