{
  "name": "writer",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:client && tsx src/server/standalone.ts",
    "check": "tsc --noEmit",
    "build:client": "npm run build:client:legacy && npm run build:client:v2",
    "build": "npm run build:client && node build.mjs",
    "start": "node dist/writer.cjs",
    "test": "tsx --test src/server/security.test.ts src/client/list-numbering.test.ts",
    "build:client:legacy": "esbuild src/client/main.ts --bundle --outdir=dist/client --format=esm --target=es2020 --minify",
    "build:client:v2": "esbuild src/client-v2/main.ts --bundle --outdir=dist/client/v2 --format=esm --target=es2020 --minify",
    "test:browser": "playwright test --config=tests/browser/playwright.config.ts",
    "test:browser:serve": "node tests/browser/serve-fixture.mjs",
    "test:e2e": "playwright test --config=tests/browser/playwright.e2e.config.ts",
    "test:e2e:serve": "node --import tsx tests/browser/serve-writer-app.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@hono/node-server": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "hono": "^4.13.13",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.56.1"
  }
}
